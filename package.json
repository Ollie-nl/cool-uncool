{
  "name": "react-app",
  "version": "0.8.0",
  "private": false,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "pnpm run generate-months && vite",
    "build": "pnpm run generate-months && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && git add docs && git commit --allow-empty -m 'Deploy to GitHub Pages' && git push origin main",
    "prettier": "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write .",
    "generate-months": "node generateAvailableMonths.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
